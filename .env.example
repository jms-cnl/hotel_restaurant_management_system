# Backend-only values. Never expose SUPABASE_KEY through a VITE_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,https://your-frontend-site.example
# Set this to the deployed frontend's password-reset page in production.
FRONTEND_RESET_REDIRECT_URL=http://localhost:5173/reset-password
