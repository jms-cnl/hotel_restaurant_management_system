# Backend-only Supabase project URL and publishable/anon key. Never expose these through VITE_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
# Server-only Supabase service-role/secret credential. Required by the session-store client only.
SUPABASE_SESSION_STORE_SERVICE_ROLE_KEY=your-service-role-secret
# Server-only base64 encoding of exactly 32 random bytes. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never use a VITE_ variable for this key.
HRMS_SESSION_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Positive integer identifying the active key. Current implementation supports this version only.
HRMS_SESSION_ENCRYPTION_KEY_VERSION=1
# Optional. Defaults to 3000 and 0.0.0.0.
PORT=3000
HOST=0.0.0.0
# Exact comma-separated frontend origins (scheme, host, optional port; no paths or wildcard).
CORS_ORIGINS=http://localhost:5173,https://your-frontend-site.example
# Optional: strict, lax, or none. Defaults to lax in development and none in production.
# HRMS_SESSION_COOKIE_SAME_SITE=none
# Set this to the deployed frontend's password-reset page; production must use the deployed HTTPS URL.
FRONTEND_RESET_REDIRECT_URL=http://localhost:5173/reset-password
# Set by the hosting environment to production for secure cookie behavior.
# NODE_ENV=production
# Frontend build-time configuration is in frontend/.env.example (VITE_API_BASE_URL).
